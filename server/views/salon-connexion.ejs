<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Connexion Salon — La Table de Carthage</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Marcellus&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
</head>
<body>
<main style="display:grid;place-items:center;min-height:100vh">
  <div class="card" style="width:min(90vw,380px)">
    <h1 style="text-align:center;font-size:1.5rem">Salon</h1>
    <% if (erreurGenerale) { %><div class="alerte alerte--erreur"><%= erreurGenerale %></div><% } %>
    <form method="post" action="/salon/connexion" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="f-email">E-mail</label>
        <input type="email" id="f-email" name="email" value="<%= valeurs.email || '' %>" required autofocus>
      </div>
      <div class="field">
        <label for="f-mdp">Mot de passe</label>
        <input type="password" id="f-mdp" name="motDePasse" required>
      </div>
      <button type="submit" class="btn" style="width:100%">Se connecter</button>
    </form>
  </div>
</main>
</body>
</html>
