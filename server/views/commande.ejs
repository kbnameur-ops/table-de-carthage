<%- entete %>
<div class="page-head">
  <div class="wrap">
    <p class="page-head__kicker">La Table de Carthage</p>
    <h1>Commander à emporter</h1>
    <p class="lead">Composez votre commande, choisissez une heure de retrait. Le paiement se fait sur place, au retrait.</p>
  </div>
</div>
<div class="wrap">
  <% if (erreurGenerale) { %>
    <div class="alerte alerte--erreur"><%= erreurGenerale %></div>
  <% } %>

  <form method="post" action="/commander" id="formCommande" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <h2>La carte</h2>
    <% categories.forEach(cat => { %>
      <div class="card">
        <h3 style="margin:0 0 1rem;font-family:var(--ff-title);font-weight:400;color:var(--gold-500)"><%= cat.nom %></h3>
        <div class="menu-carte">
          <% cat.plats.forEach(plat => { %>
            <div class="menu-plat">
              <% if (plat.photo) { %>
                <img class="plat-photo" src="<%= plat.photo %>" alt="">
              <% } else { %>
                <div class="plat-photo plat-photo--placeholder" aria-hidden="true"><%= plat.nom.charAt(0) %></div>
              <% } %>
              <div class="menu-plat__infos">
                <h4><%= plat.nom %><% if (plat.vegetarien) { %> <span class="badge badge--veg">Végé</span><% } %></h4>
                <p><%= plat.description %></p>
              </div>
              <div class="menu-plat__prix"><%= euros(plat.prix_cents) %></div>
              <div class="compteur" data-plat="<%= plat.id %>">
                <button type="button" class="compteur__btn js-moins" aria-label="Retirer un <%= plat.nom %>">−</button>
                <input type="number" min="0" max="20" value="<%= (valeurs.quantites || {})[plat.id] || 0 %>"
                       name="qte_<%= plat.id %>" data-prix="<%= plat.prix_cents %>" class="js-qte"
                       inputmode="numeric" aria-label="Quantité de <%= plat.nom %>">
                <button type="button" class="compteur__btn js-plus" aria-label="Ajouter un <%= plat.nom %>">+</button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    <% }) %>

    <div class="panier-total">
      <span>Total <em id="nbArticles">Panier vide</em></span>
      <strong id="totalPanier">0,00 €</strong>
    </div>
    <% if (erreurs.panier) { %><div class="alerte alerte--erreur"><%= erreurs.panier %></div><% } %>

    <h2>Retrait</h2>
    <div class="card">
      <div class="field--row">
        <div class="field <%= erreurs.date ? 'champ-invalide' : '' %>">
          <label for="f-date">Date</label>
          <input type="date" id="f-date" name="date" min="<%= aujourdHui %>" value="<%= valeurs.date || '' %>" required>
          <% if (erreurs.date) { %><span class="erreur"><%= erreurs.date %></span><% } %>
        </div>
        <div class="field <%= erreurs.heure ? 'champ-invalide' : '' %>">
          <label for="f-heure-select">Heure de retrait</label>
          <select id="f-heure-select" name="heure" required>
            <option value="">— choisir une date —</option>
          </select>
          <% if (erreurs.heure) { %><span class="erreur"><%= erreurs.heure %></span><% } %>
        </div>
      </div>
    </div>

    <h2>Vos coordonnées</h2>

    <% if (client) { %>
      <div class="card carte-identifie">
        <div class="identifie">
          <span class="identifie__pastille" aria-hidden="true"><%= client.prenom.charAt(0) %><%= client.nom.charAt(0) %></span>
          <div class="identifie__qui">
            <strong><%= client.prenom %> <%= client.nom %></strong>
            <small><%= client.telephone_saisi %> · <%= client.email %></small>
          </div>
          <button type="submit" name="action" value="changer" class="btn btn--ghost btn--sm">Ce n'est pas moi</button>
        </div>
      </div>
    <% } else { %>
      <div class="card bloc-identite">
        <div class="identite-choix">
          <section class="identite-choix__col">
            <h3>Déjà venu chez nous&nbsp;?</h3>
            <p class="aide">Retrouvez vos informations avec votre téléphone et votre date de naissance.</p>
            <% if (erreurConnexion) { %>
              <div class="alerte alerte--erreur" style="margin-bottom:1rem"><%= erreurConnexion %></div>
            <% } %>
            <div class="field">
              <label for="c-tel">Téléphone</label>
              <input type="tel" id="c-tel" name="telephone" value="<%= valeurs.telephone || '' %>" autocomplete="tel">
            </div>
            <div class="field">
              <label for="c-naissance">Date de naissance</label>
              <input type="date" id="c-naissance" name="dateNaissance" value="<%= valeurs.dateNaissance || '' %>">
            </div>
            <button type="submit" name="action" value="connexion" class="btn btn--bloc">Me reconnaître</button>
          </section>

          <div class="identite-choix__ou" aria-hidden="true"><span>ou</span></div>

          <section class="identite-choix__col">
            <h3>Première fois&nbsp;?</h3>
            <p class="aide">Renseignez vos coordonnées : votre espace client sera créé automatiquement.</p>
            <div class="field--row">
              <div class="field <%= erreurs.prenom ? 'champ-invalide' : '' %>">
                <label for="f-prenom">Prénom</label>
                <input type="text" id="f-prenom" name="prenom" value="<%= valeurs.prenom || '' %>" autocomplete="given-name">
                <% if (erreurs.prenom) { %><span class="erreur"><%= erreurs.prenom %></span><% } %>
              </div>
              <div class="field <%= erreurs.nom ? 'champ-invalide' : '' %>">
                <label for="f-nom">Nom</label>
                <input type="text" id="f-nom" name="nom" value="<%= valeurs.nom || '' %>" autocomplete="family-name">
                <% if (erreurs.nom) { %><span class="erreur"><%= erreurs.nom %></span><% } %>
              </div>
            </div>
            <div class="field <%= erreurs.email ? 'champ-invalide' : '' %>">
              <label for="f-email">E-mail</label>
              <input type="email" id="f-email" name="email" value="<%= valeurs.email || '' %>" autocomplete="email">
              <% if (erreurs.email) { %><span class="erreur"><%= erreurs.email %></span><% } %>
            </div>
            <% if (erreurs.telephone) { %>
              <p class="field"><span class="erreur"><%= erreurs.telephone %></span></p>
            <% } %>
            <% if (erreurs.dateNaissance) { %>
              <p class="field"><span class="erreur"><%= erreurs.dateNaissance %></span></p>
            <% } %>
            <p class="aide">Le téléphone et la date de naissance demandés pour vous reconnaître servent aussi à créer votre compte&nbsp;: ce sont eux qui vous permettront d'y accéder ensuite.</p>
          </section>
        </div>
      </div>
    <% } %>

    <div class="card">
      <div class="field">
        <label for="f-message">Message (facultatif)</label>
        <textarea id="f-message" name="message" rows="3"><%= valeurs.message || '' %></textarea>
      </div>
    </div>

    <div class="btn-row">
      <button type="submit" class="btn">Valider la commande</button>
    </div>
  </form>
</div>

<script>
(function () {
  const qteInputs = Array.from(document.querySelectorAll('.js-qte'));
  const totalEl = document.getElementById('totalPanier');

  function recalc() {
    let total = 0, articles = 0;
    for (const i of qteInputs) {
      const q = parseInt(i.value, 10) || 0;
      total += q * parseInt(i.dataset.prix, 10);
      articles += q;
      // La ligne se met en avant dès qu'elle est au panier : sur une carte
      // longue, on doit retrouver d'un coup d'œil ce qu'on a déjà choisi.
      i.closest('.menu-plat')?.classList.toggle('est-choisi', q > 0);
      i.closest('.compteur')?.classList.toggle('est-actif', q > 0);
    }
    totalEl.textContent = (total / 100).toLocaleString('fr-FR', { minimumFractionDigits: 2 }) + ' €';
    const compteArticles = document.getElementById('nbArticles');
    if (compteArticles) {
      compteArticles.textContent = articles ? articles + (articles > 1 ? ' articles' : ' article') : 'Panier vide';
    }
  }

  // Les deux boutons bornent la valeur aux mêmes limites que le champ, que
  // le serveur revérifie de toute façon : ici c'est du confort, pas un
  // contrôle de sécurité.
  function ajuster(input, delta) {
    const min = parseInt(input.min, 10) || 0;
    const max = parseInt(input.max, 10) || 20;
    const actuel = parseInt(input.value, 10) || 0;
    input.value = Math.min(max, Math.max(min, actuel + delta));
    recalc();
  }

  document.querySelectorAll('.compteur').forEach(c => {
    const input = c.querySelector('.js-qte');
    c.querySelector('.js-moins').addEventListener('click', () => ajuster(input, -1));
    c.querySelector('.js-plus').addEventListener('click', () => ajuster(input, +1));
  });
  qteInputs.forEach(i => i.addEventListener('input', recalc));
  recalc();

  const dateEl = document.getElementById('f-date');
  const heureSel = document.getElementById('f-heure-select');
  const heureVoulue = <%- JSON.stringify(valeurs.heure || '') %>;
  // Même précaution que sur /reserver : ne jamais laisser une réponse
  // périmée (date changée deux fois de suite) écraser la plus récente.
  let sequenceHoraires = 0;
  let derniereDateChargee = null;
  async function chargerHoraires() {
    // Cliquer dans le <select> retire le focus du champ date : même piège
    // que sur /reserver, un blur peut redéclencher 'change' sans que la
    // date ait changé, et effacerait la liste au moment où l'utilisateur
    // l'ouvre. On ignore les rechargements pour une date déjà chargée.
    if (dateEl.value === derniereDateChargee) return;
    derniereDateChargee = dateEl.value;

    const jeton = ++sequenceHoraires;
    heureSel.innerHTML = '<option value="">Chargement…</option>';
    if (!dateEl.value) { heureSel.innerHTML = '<option value="">— choisir une date —</option>'; return; }
    try {
      const r = await fetch(`/api/horaires-retrait?date=${encodeURIComponent(dateEl.value)}`);
      const d = await r.json();
      if (jeton !== sequenceHoraires) return;
      if (!d.creneaux.length) {
        heureSel.innerHTML = '<option value="">Fermé ce jour-là</option>';
        return;
      }
      heureSel.innerHTML = d.creneaux.map(h => `<option value="${h}">${h}</option>`).join('');
      if (d.creneaux.includes(heureVoulue)) heureSel.value = heureVoulue;
    } catch {
      if (jeton !== sequenceHoraires) return;
      heureSel.innerHTML = '<option value="">Indisponible</option>';
    }
  }
  dateEl.addEventListener('change', chargerHoraires);
  if (dateEl.value) chargerHoraires();
})();
</script>
<%- pied %>
