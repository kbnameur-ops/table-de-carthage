<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= titre %> — Service · La Table de Carthage</title>
<link rel="icon" href="/assets/img/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Jost:wght@200;300;400;500;600&family=Marcellus&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= cssApp %>">
<%- teteApp %>
</head>
<body class="salon service">
<header class="servicebar">
  <a class="servicebar__retour" href="/service" aria-label="Retour au plan de salle">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h10" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </a>
  <div class="servicebar__titre">
    <b><%= titre %></b>
    <small><%= sousTitre || '' %></small>
  </div>
  <div class="servicebar__qui"><%= qui || '' %></div>
</header>
<nav class="serviceonglets" aria-label="Navigation du service">
  <% if (droits.service) { %>
    <a href="/service"<%- actif === 'salle' ? ' class="is-active"' : '' %>>Salle</a>
    <a href="/service/emporter"<%- actif === 'emporter' ? ' class="is-active"' : '' %>>À emporter</a>
    <a href="/service/caisse"<%- actif === 'caisse' ? ' class="is-active"' : '' %>>Caisse</a>
  <% } %>
  <% if (droits.cuisine) { %>
    <!-- La cuisine a son propre écran, pas un onglet du service : le lien
         sort de la barre plutôt que d'y prétendre à une place égale. -->
    <a href="/cuisine" class="serviceonglets__ailleurs">Cuisine ↗</a>
  <% } %>
</nav>
<main class="servicemain">
