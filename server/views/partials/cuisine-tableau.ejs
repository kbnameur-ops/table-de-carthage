<% if (!tableau.commandes.length) { %>
  <p class="passe-vide">Rien au feu. Les commandes arrivent ici dès qu'elles sont passées.</p>
<% } else { %>
  <div class="passe-colonnes">
    <% ETATS.forEach(etat => { %>
      <section class="passe-col passe-col--<%= etat.replace('_','') %>" data-colonne="<%= etat %>">
        <h2 class="passe-col__titre">
          <%= LIBELLES[etat] %>
          <span class="passe-col__compte" data-colonne-compte="<%= etat %>"><%= tableau.parEtat[etat].length %></span>
        </h2>

        <p class="passe-col__vide" data-vide="<%= etat %>"<%- tableau.parEtat[etat].length ? ' hidden' : '' %>>—</p>

        <% tableau.parEtat[etat].forEach(cmd => { %>
          <article class="ticket ticket--<%= cmd.type === 'sur_place' ? 'salle' : 'emporter' %><%= cmd.urgence === 'tardif' ? ' est-tardif' : (cmd.urgence === 'long' ? ' est-long' : '') %>"
                   data-type="<%= cmd.type %>" data-id="<%= cmd.id %>">
            <header class="ticket__tete">
              <% if (cmd.type === 'sur_place') { %>
                <b class="ticket__origine"><%= nomTable(cmd.table_nom) %></b>
                <span class="ticket__minutes"><%= cmd.minutes %> min</span>
              <% } else { %>
                <b class="ticket__origine ticket__origine--emporter">À emporter</b>
                <span class="ticket__minutes">
                  <% if (cmd.avantRetrait === null) { %>
                    <%= cmd.heure %>
                  <% } else if (cmd.avantRetrait <= 0) { %>
                    retard <%= -cmd.avantRetrait %> min
                  <% } else if (cmd.avantRetrait < 60) { %>
                    dans <%= cmd.avantRetrait %> min
                  <% } else { %>
                    dans <%= Math.floor(cmd.avantRetrait / 60) %> h<%= String(cmd.avantRetrait % 60).padStart(2,'0') %>
                  <% } %>
                </span>
              <% } %>
            </header>

            <p class="ticket__qui">
              <%= cmd.prenom %>
              <% if (cmd.type === 'emporter') { %>
                <span class="ticket__retrait">Retrait <b><%= cmd.heure %></b></span>
              <% } %>
            </p>

            <ul class="ticket__lignes">
              <% cmd.lignes.forEach(l => { %>
                <li><b><%= l.quantite %></b> <%= l.nom %></li>
              <% }) %>
            </ul>

            <% if (cmd.message) { %>
              <p class="ticket__mot"><%= cmd.message %></p>
            <% } %>

            <div class="ticket__actions">
              <% if (cmd.suivant) { %>
                <form method="post" action="/cuisine/<%= cmd.id %>/avancer">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="vers" value="<%= cmd.suivant %>">
                  <button type="submit" class="btn btn--bloc"><%= LIBELLES[cmd.suivant] %></button>
                </form>
              <% } else { %>
                <form method="post" action="/cuisine/<%= cmd.id %>/retour">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn--ghost btn--bloc">Remettre au feu</button>
                </form>
              <% } %>
            </div>
          </article>
        <% }) %>
      </section>
    <% }) %>
  </div>
<% } %>
