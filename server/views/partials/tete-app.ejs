<link rel="manifest" href="/manifeste/<%= espace %>.webmanifest">
<meta name="theme-color" content="#071A31">
<meta name="application-name" content="<%= court %>">
<!-- iOS ne lit pas le manifeste pour « Sur l'écran d'accueil » : le nom sous
     l'icône vient de cette balise, et l'icône de apple-touch-icon. -->
<meta name="apple-mobile-web-app-title" content="<%= court %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="apple-touch-icon" href="/assets/img/icones/icone-180.png">
