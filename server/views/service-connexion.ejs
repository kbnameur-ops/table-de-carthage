<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Prise de commande — La Table de Carthage</title>
<link rel="icon" href="/assets/img/logo.jpg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@300;400;500&family=Marcellus&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%= cssApp %>">
<%- teteApp %>
</head>
<body>
<main style="display:grid;place-items:center;min-height:100vh;padding:1.2rem">
  <div class="card" style="width:min(94vw,390px)">
    <h1 style="text-align:center;font-size:1.45rem;margin-top:0">Prise de commande</h1>
    <p class="aide" style="text-align:center">Votre identifiant vous est remis par la direction.</p>
    <% if (erreurGenerale) { %><div class="alerte alerte--erreur"><%= erreurGenerale %></div><% } %>
    <form method="post" action="/service/connexion" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="f-id">Identifiant</label>
        <input type="text" id="f-id" name="identifiant" value="<%= valeurs.identifiant || '' %>"
               required autofocus autocapitalize="none" autocorrect="off" spellcheck="false"
               autocomplete="username" inputmode="text">
      </div>
      <div class="field">
        <label for="f-mdp">Mot de passe</label>
        <input type="password" id="f-mdp" name="motDePasse" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn" style="width:100%">Entrer en service</button>
    </form>
  </div>
</main>
<%- epingler %>
</body>
</html>
