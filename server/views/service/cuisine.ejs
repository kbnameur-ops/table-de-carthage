<%- serviceEntete %>

<div id="tableauCuisine">
  <%- tableauHtml %>
</div>

<script>
// L'écran vit au-dessus du piano : il doit se tenir à jour sans que
// personne ne le touche. On remplace le contenu plutôt que de recharger la
// page — un rechargement ferait sauter le défilement et clignoter l'écran
// toutes les quinze secondes. On ne sonde pas quand l'onglet est masqué.
(function () {
  const cible = document.getElementById('tableauCuisine');
  if (!cible) return;
  let enCours = false;

  async function rafraichir() {
    if (enCours || document.hidden) return;
    // Une soumission en cours ne doit pas se faire arracher son bouton.
    if (document.activeElement && document.activeElement.tagName === 'BUTTON') return;
    enCours = true;
    try {
      const r = await fetch('/cuisine/tableau', { headers: { 'Accept': 'text/html' } });
      if (r.ok) {
        const html = await r.text();
        // La session a pu expirer : on reçoit alors une redirection suivie
        // d'une page de connexion, qu'il ne faut surtout pas injecter ici.
        if (r.redirected) { location.href = r.url; return; }
        cible.innerHTML = html;
      }
    } catch { /* réseau capricieux en cuisine : on retentera */ }
    finally { enCours = false; }
  }

  setInterval(rafraichir, 15000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) rafraichir(); });
})();
</script>

<%- servicePied %>
