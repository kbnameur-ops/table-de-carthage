<%- entete %>
<div class="wrap">
  <h1>Bonjour <%= client.prenom %></h1>
  <p class="lead"><%= client.email %> · <%= client.telephone_saisi %></p>

  <% if (message) { %><div class="alerte alerte--ok"><%= message %></div><% } %>
  <% if (erreurCagnotte) { %><div class="alerte alerte--erreur"><%= erreurCagnotte %></div><% } %>

  <div class="card cagnotte">
    <div>
      <span class="cagnotte__quoi">Ma cagnotte</span>
      <div class="cagnotte__somme"><%= euros(client.cagnotte_cents) %></div>
      <p class="cagnotte__aide">
        <%= taux %> % de chaque addition réglée revient sur votre cagnotte, utilisable
        au restaurant sur une prochaine commande.
      </p>
    </div>
  </div>

  <h2>Envoyer des points</h2>
  <div class="card">
    <p class="aide">
      Une seule personne règle l'addition et gagne pour toute la table&nbsp;: elle peut
      ensuite rendre à chacun sa part. Le destinataire doit avoir un espace client
      sur le numéro que vous indiquez.
    </p>
    <form method="post" action="/compte/cagnotte/envoyer" class="ligne-champs">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="f-dest">Téléphone du destinataire</label>
        <input type="tel" id="f-dest" name="telephone" inputmode="tel" required
               autocomplete="off" placeholder="06 12 34 56 78">
      </div>
      <div class="field">
        <label for="f-montant">Montant</label>
        <input type="text" id="f-montant" name="montant" inputmode="decimal" required
               autocomplete="off" placeholder="5,00">
      </div>
      <div class="field">
        <label for="f-mot">Motif (facultatif)</label>
        <input type="text" id="f-mot" name="mot" maxlength="80" placeholder="Ta part de samedi">
      </div>
      <button type="submit" class="btn"
              <%- client.cagnotte_cents > 0 ? '' : 'disabled' %>>Envoyer</button>
    </form>
  </div>

  <h2>Mouvements de la cagnotte</h2>
  <% if (!mouvements.length) { %>
    <p class="vide">Rien pour l'instant. Votre première addition réglée créditera votre cagnotte.</p>
  <% } else { %>
    <div class="card">
      <div class="mouvements">
        <% mouvements.forEach(m => { %>
          <div class="mouvement">
            <span class="mouvement__quoi">
              <span><%= m.libelle %></span>
              <small><%= new Date(m.cree_le).toLocaleDateString('fr-FR', { day:'2-digit', month:'long', year:'numeric' }) %></small>
            </span>
            <span class="mouvement__delta <%= m.delta_cents > 0 ? 'est-positif' : 'est-negatif' %>">
              <%= m.delta_cents > 0 ? '+' : '−' %><%= euros(Math.abs(m.delta_cents)) %>
            </span>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (tablee) { %>
    <h2>Votre table en ce moment</h2>
    <div class="card carte-identifie">
      <p style="margin:0 0 .6rem">
        Vous êtes installé <strong><%= nomTable(tablee.table_nom).toLowerCase() %></strong>.
        Tout ce que vous commandez depuis cette page rejoint cette addition.
      </p>
      <% if (addition.commandes.length) { %>
        <div class="addition">
          <% addition.commandes.forEach(cmd => { %>
            <div class="addition__cmd<%= cmd.statut === 'annulee' ? ' est-annulee' : '' %>">
              <div class="addition__entete">
                <span><%= cmd.heure %></span>
                <span class="badge badge--<%= cmd.statut.replace('_','') %>"><%= cmd.statut.replace('_',' ') %></span>
              </div>
              <% cmd.lignes.forEach(l => { %>
                <div class="addition__ligne">
                  <span><%= l.quantite %> × <%= l.nom %></span>
                  <span><%= euros(l.prix_cents * l.quantite) %></span>
                </div>
              <% }) %>
            </div>
          <% }) %>
        </div>
        <div class="panier-total" style="margin-bottom:1rem">
          <span>Total de la table</span><strong><%= euros(addition.total) %></strong>
        </div>
      <% } %>
      <a class="btn" href="/table/<%= tablee.code_qr %>">Commander à ma table</a>
    </div>
  <% } %>

  <h2>Réservations</h2>
  <% if (!reservations.length) { %>
    <p class="vide">Aucune réservation pour l'instant.</p>
  <% } else { %>
    <div class="table-scroll"><table>
      <thead><tr><th>Référence</th><th>Date</th><th>Heure</th><th>Couverts</th><th>Statut</th><th></th></tr></thead>
      <tbody>
        <% reservations.forEach(r => { %>
          <tr>
            <td><%= r.reference %></td>
            <td><%= r.date %></td>
            <td><%= r.heure %></td>
            <td><%= r.couverts %></td>
            <td><span class="badge badge--<%= r.statut.replace('_','') %>"><%= libellesStatutResa[r.statut] %></span></td>
            <td>
              <% if (r.annulable) { %>
                <form method="post" action="/compte/reservations/<%= r.id %>/annuler" onsubmit="return confirm('Annuler cette réservation ?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn--danger btn--sm">Annuler</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>

  <h2>Commandes à emporter</h2>
  <p class="lead" style="margin-bottom:1rem">Les commandes servies à table figurent dans l'addition de la table, pas ici.</p>
  <% if (!commandes.length) { %>
    <p class="vide">Aucune commande pour l'instant.</p>
  <% } else { %>
    <div class="table-scroll"><table>
      <thead><tr><th>Référence</th><th>Retrait</th><th>Total</th><th>Statut</th><th></th></tr></thead>
      <tbody>
        <% commandes.forEach(c => { %>
          <tr>
            <td><%= c.reference %></td>
            <td><%= c.date %> à <%= c.heure %></td>
            <td><%= euros(c.total_cents) %></td>
            <td><span class="badge badge--<%= c.statut.replace('_','') %>"><%= libellesStatutCmd[c.statut] %></span></td>
            <td>
              <% if (c.annulable) { %>
                <form method="post" action="/compte/commandes/<%= c.id %>/annuler" onsubmit="return confirm('Annuler cette commande ?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn--danger btn--sm">Annuler</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>

  <div class="btn-row">
    <a class="btn" href="/reserver">Nouvelle réservation</a>
    <a class="btn btn--ghost" href="/commander">Nouvelle commande</a>
    <form method="post" action="/compte/deconnexion">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn--ghost">Se déconnecter</button>
    </form>
  </div>
</div>
<%- pied %>
