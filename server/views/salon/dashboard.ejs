<%- salonEntete %>
<div class="page-titre">
  <h1>Tableau de bord</h1>
  <p class="lead">L'essentiel du jour. Chaque tuile mène directement à l'écran concerné.</p>
</div>

<div class="tuiles tuiles--dashboard">
  <a class="tuile tuile--lien" href="/salon/reservations?date=<%= aujourdHui %>">
    <b><%= resaAujourdhui.n %></b>
    <span>Réservations aujourd'hui</span>
    <em><%= resaAujourdhui.couverts %> couvert<%= resaAujourdhui.couverts > 1 ? 's' : '' %></em>
  </a>
  <a class="tuile tuile--lien<%= resaAttente.n ? ' tuile--accent' : '' %>" href="/salon/reservations?date=a-venir&statut=en_attente">
    <b><%= resaAttente.n %></b>
    <span>Réservations en attente</span>
    <em><%= resaAttente.n ? 'à confirmer' : 'rien à traiter' %></em>
  </a>
  <a class="tuile tuile--lien" href="/salon/commandes?date=<%= aujourdHui %>">
    <b><%= cmdAujourdhui.n %></b>
    <span>Commandes aujourd'hui</span>
    <em><%= euros(cmdAujourdhui.total) %></em>
  </a>
  <a class="tuile tuile--lien<%= cmdAttente.n ? ' tuile--accent' : '' %>" href="/salon/commandes?date=a-venir&statut=en_attente">
    <b><%= cmdAttente.n %></b>
    <span>Commandes en attente</span>
    <em><%= cmdAttente.n ? 'à confirmer' : 'rien à traiter' %></em>
  </a>
</div>

<h2>Accès rapide</h2>
<div class="acces-rapide">
  <a class="acces" href="/salon/salle">
    <b>Salle</b>
    <span>Plan de salle du créneau en cours : occuper ou libérer une table.</span>
  </a>
  <a class="acces" href="/salon/tables-clients">
    <b>Tables clients</b>
    <span>Qui est attablé, l'addition en cours, l'encaissement.</span>
  </a>
  <a class="acces" href="/salon/clients">
    <b>Clients</b>
    <span>Le fichier client, son historique et vos notes.</span>
  </a>
  <a class="acces" href="/salon/reservations">
    <b>Réservations</b>
    <span>Le carnet, jour par jour, avec les statuts.</span>
  </a>
  <a class="acces" href="/salon/commandes">
    <b>Commandes à emporter</b>
    <span>Le détail des paniers et les heures de retrait.</span>
  </a>
  <a class="acces" href="/salon/carte">
    <b>La carte</b>
    <span>Catégories, plats, photos et prix.</span>
  </a>
  <a class="acces" href="/salon/services">
    <b>Services &amp; tables</b>
    <span>Horaires, capacité de la salle, fermetures.</span>
  </a>
  <a class="acces" href="/salon/equipe">
    <b>Équipe</b>
    <span>Effectif, planning de la semaine, présences.</span>
  </a>
  <a class="acces" href="/salon/qr">
    <b>QR des tables</b>
    <span>La planche à imprimer et coller sur chaque table.</span>
  </a>
  <a class="acces" href="/salon/analyse">
    <b>Analyse</b>
    <span>Chiffre d'affaires, plats vendus, CA par serveur — et l'export pour aller plus loin.</span>
  </a>
  <a class="acces" href="/service" target="_blank" rel="noopener">
    <b>Prise de commande ↗</b>
    <span>L'écran de la salle : plan, commandes, caisse.</span>
  </a>
  <a class="acces" href="/cuisine" target="_blank" rel="noopener">
    <b>Cuisine ↗</b>
    <span>Le passe : nouvelles, lues, en préparation, prêtes.</span>
  </a>
</div>
<%- salonPied %>
