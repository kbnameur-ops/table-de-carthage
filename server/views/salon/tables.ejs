<%- salonEntete %>
<div class="page-titre">
  <p class="fil"><a href="/salon/services">Services</a> · <%= service.nom %></p>
  <h1>Tables de la salle</h1>
  <p class="lead">
    La capacité du service découle de ces tables : une réservation n'est acceptée
    que s'il reste une table libre assez grande. Total actuel :
    <strong><%= tables.filter(t => t.actif).length %> tables · <%= total %> places</strong>.
    Une table qui a déjà servi ne se supprime pas — décochez « En service » pour
    la retirer de la salle sans effacer ses additions.
  </p>
</div>

<% if (erreur) { %><div class="alerte alerte--erreur"><%= erreur %></div><% } %>
<% if (info) { %><div class="alerte alerte--ok"><%= info %></div><% } %>

<%# Un nom porté par deux tables ne se voit pas en lisant la liste : les
    lignes se ressemblent toutes. Or le serveur qui lit « Table 1 » sur son
    écran ne saura pas de laquelle il s'agit, et les deux QR imprimés sont
    identiques une fois collés. %>
<% if (doublons.length) { %>
  <div class="alerte alerte--erreur">
    <strong>Deux tables portent le même nom.</strong>
    <%= doublons.map(d => `« ${d.nom} » (${d.n} fois)`).join(', ') %>.
    Sur le plan de salle comme sur les QR imprimés, rien ne les distingue :
    renommez-en une ci-dessous, puis réimprimez sa planche.
  </div>
<% } %>

<div class="btn-row" style="margin-top:0;margin-bottom:1.5rem">
  <a class="btn btn--ghost" href="/salon/services/<%= service.id %>/qr">QR codes à imprimer</a>
</div>

<div class="card" style="margin-bottom:1.8rem">
  <h2 style="margin-top:0">Ajouter des tables</h2>
  <form method="post" action="/salon/services/<%= service.id %>/tables" class="ligne-champs">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="f-nom">Nom</label>
      <input type="text" id="f-nom" name="nom" required maxlength="40" placeholder="Table" value="Table">
    </div>
    <div class="field">
      <label for="f-couverts">Couverts</label>
      <input type="number" id="f-couverts" name="couverts" min="1" max="30" value="4" required>
    </div>
    <div class="field">
      <label for="f-nombre">Combien</label>
      <input type="number" id="f-nombre" name="nombre" min="1" max="40" value="1">
    </div>
    <button type="submit" class="btn">Ajouter</button>
  </form>
  <p class="aide">Au-delà d'une table, le nom est numéroté automatiquement : « Table 1 », « Table 2 »…
     Chaque table reçoit son propre QR à l'ajout : pensez à réimprimer la planche.</p>
</div>

<% if (!tables.length) { %>
  <div class="alerte alerte--info">Aucune table pour l'instant : le service n'accepte donc aucune réservation.</div>
<% } else { %>
  <div class="liste-tables">
    <% tables.forEach(t => { %>
      <form method="post" action="/salon/tables/<%= t.id %>" class="card carte-table<%= t.actif ? '' : ' est-inactive' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="ligne-champs ligne-champs--serree">
          <div class="field">
            <label>Nom</label>
            <input type="text" name="nom" value="<%= t.nom %>" required maxlength="40">
          </div>
          <div class="field field--court">
            <label>Couverts</label>
            <input type="number" name="couverts" value="<%= t.couverts %>" min="1" max="30" required>
          </div>
          <label class="case">
            <input type="checkbox" name="actif" <%- t.actif ? 'checked' : '' %>>
            <span>En service</span>
          </label>
        </div>
        <% const servi = additions[t.id] || 0; %>
        <div class="btn-row btn-row--serree">
          <button type="submit" class="btn btn--sm">Enregistrer</button>
          <% if (servi) { %>
            <%# Une table qui a déjà servi porte des additions : la supprimer
                effacerait de l'historique de caisse. On la retire du service
                à la place, ce que fait la case « En service ». %>
            <span class="carte-table__tenue" title="<%= servi %> addition<%= servi > 1 ? 's' : '' %> passée<%= servi > 1 ? 's' : '' %> sur cette table">
              <%= servi %> addition<%= servi > 1 ? 's' : '' %> — se retire en décochant
            </span>
          <% } else { %>
            <button type="submit" class="btn btn--danger btn--sm"
                    formnovalidate
                    formaction="/salon/tables/<%= t.id %>/supprimer"
                    onclick="return confirm('Supprimer cette table ? Les réservations déjà placées dessus resteront valides, mais sans table attribuée.')">Supprimer</button>
          <% } %>
        </div>
      </form>
    <% }) %>
  </div>
<% } %>
<%- salonPied %>
