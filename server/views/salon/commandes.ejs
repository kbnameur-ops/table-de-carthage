<%- salonEntete %>
<h1>Commandes à emporter</h1>

<form method="get" action="/salon/commandes" class="filtre-bar">
  <div class="field">
    <label for="f-date">Date</label>
    <input type="date" id="f-date" name="date" value="<%= date %>" onchange="this.form.submit()">
  </div>
  <div class="field">
    <label for="f-statut">Statut</label>
    <select id="f-statut" name="statut" onchange="this.form.submit()">
      <option value="">Tous</option>
      <% statuts.forEach(s => { %>
        <option value="<%= s %>" <%= s === statut ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
      <% }) %>
    </select>
  </div>
  <div class="stat-tuile" style="padding:.8rem 1.2rem"><b style="font-size:1.4rem"><%= euros(total) %></b><span>Total ce jour</span></div>
</form>

<% if (!commandes.length) { %>
  <p class="vide">Aucune commande pour cette date.</p>
<% } else { %>
<div class="table-scroll">
<table>
  <thead><tr><th>Heure</th><th>Client</th><th>Contact</th><th>Détail</th><th>Total</th><th>Message</th><th>Statut</th></tr></thead>
  <tbody>
    <% commandes.forEach(c => { %>
      <tr>
        <td><%= c.heure %></td>
        <td><%= c.prenom %> <%= c.nom %><br><small style="color:var(--muted)"><%= c.reference %></small></td>
        <td><a href="tel:<%= c.telephone_saisi %>"><%= c.telephone_saisi %></a><br><small><%= c.email %></small></td>
        <td>
          <% c.lignes.forEach(l => { %>
            <div><%= l.quantite %> × <%= l.nom %></div>
          <% }) %>
        </td>
        <td><%= euros(c.total_cents) %></td>
        <td style="max-width:200px"><%= c.message || '—' %></td>
        <td>
          <form method="post" action="/salon/commandes/<%= c.id %>/statut">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <select name="statut" onchange="this.form.submit()" class="badge badge--<%= c.statut.replace('_','') %>" style="border:0;padding:.3rem .5rem">
              <% statuts.forEach(s => { %>
                <option value="<%= s %>" <%= s === c.statut ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
              <% }) %>
            </select>
          </form>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- salonPied %>
