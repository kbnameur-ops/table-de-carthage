<%- salonEntete %>
<div class="page-titre">
  <h1>Commandes à emporter</h1>
</div>

<div class="nav-jour">
  <% if (!aVenir) { %>
    <a class="nav-jour__fleche" href="/salon/commandes?date=<%= veille %><%= statut ? '&statut=' + statut : '' %>" aria-label="Jour précédent">‹</a>
  <% } %>
  <div class="nav-jour__centre">
    <strong><%= libelle %></strong>
    <% if (!aVenir) { %><small><%= new Date(date + 'T00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></small><% } %>
  </div>
  <% if (!aVenir) { %>
    <a class="nav-jour__fleche" href="/salon/commandes?date=<%= lendemain %><%= statut ? '&statut=' + statut : '' %>" aria-label="Jour suivant">›</a>
  <% } %>
</div>

<form method="get" action="/salon/commandes" class="barre-filtres">
  <div class="field">
    <label for="f-date">Aller au jour</label>
    <input type="date" id="f-date" name="date" value="<%= date || aujourdHui %>" onchange="this.form.submit()">
  </div>
  <div class="field">
    <label for="f-statut">Statut</label>
    <select id="f-statut" name="statut" onchange="this.form.submit()">
      <option value="">Tous</option>
      <% statuts.forEach(s => { %>
        <option value="<%= s %>" <%- s === statut ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
      <% }) %>
    </select>
  </div>
  <div class="raccourcis-jour">
    <a class="btn btn--ghost btn--sm<%= date === aujourdHui ? ' est-actif' : '' %>" href="/salon/commandes<%= statut ? '?statut=' + statut : '' %>">Aujourd'hui</a>
    <a class="btn btn--ghost btn--sm<%= aVenir ? ' est-actif' : '' %>" href="/salon/commandes?date=a-venir<%= statut ? '&statut=' + statut : '' %>">Tout ce qui vient</a>
  </div>
  <div class="tuile tuile--compacte"><b><%= euros(total) %></b><span>Total</span></div>
  <noscript><button type="submit" class="btn btn--sm">Afficher</button></noscript>
</form>

<% if (info) { %><div class="alerte alerte--ok"><%= info %></div><% } %>
<% if (erreur) { %><div class="alerte alerte--erreur"><%= erreur %></div><% } %>

<% if (!commandes.length) { %>
  <p class="vide">Aucune commande<%= statut ? ' avec ce statut' : '' %> <%= aVenir ? 'à venir' : 'pour ce jour' %>.</p>
<% } else { %>
<div class="table-scroll">
<table>
  <thead><tr>
    <% if (aVenir) { %><th>Jour</th><% } %>
    <th>Retrait</th><th>Client</th><th>Contact</th><th>Détail</th><th>Total</th><th>Message</th><th>Statut</th><th>Caisse</th>
  </tr></thead>
  <tbody>
    <% commandes.forEach(c => { %>
      <tr>
        <% if (aVenir) { %>
          <td><small><%= new Date(c.date + 'T00:00').toLocaleDateString('fr-FR', { weekday: 'short', day: 'numeric', month: 'short' }) %></small></td>
        <% } %>
        <td><strong><%= c.heure %></strong></td>
        <td><%= c.prenom %> <%= c.nom %><br><small style="color:var(--muted)"><%= c.reference %></small></td>
        <td><a href="tel:<%= c.telephone_saisi %>"><%= c.telephone_saisi %></a><br><small><%= c.email %></small></td>
        <td>
          <% c.lignes.forEach(l => { %>
            <div><%= l.quantite %> × <%= l.nom %></div>
          <% }) %>
        </td>
        <td><%= euros(c.total_cents) %></td>
        <td style="max-width:200px"><%= c.message || '—' %></td>
        <td>
          <% if (c.statut === 'encaissee') { %>
            <span class="badge badge--honoree">encaissée</span>
          <% } else if (c.statut === 'a_payer') { %>
            <%# Pas de menu ici : la commande attend sa carte, et la forcer
                l'enverrait en cuisine sans que personne ne puisse la faire
                payer. Elle en sort quand le paiement aboutit. %>
            <span class="badge badge--attente">à régler</span>
          <% } else { %>
            <form method="post" action="/salon/commandes/<%= c.id %>/statut">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <select name="statut" onchange="this.form.submit()" class="badge badge--<%= c.statut.replace('_','') %>" style="border:0;padding:.3rem .5rem">
                <% statuts.forEach(s => { %>
                  <option value="<%= s %>" <%- s === c.statut ? 'selected' : '' %>><%= s.replace('_',' ') %></option>
                <% }) %>
              </select>
            </form>
          <% } %>
        </td>
        <td>
          <% if (c.statut === 'encaissee') { %>
            <small style="color:var(--muted)">
              <% if (c.remise_cagnotte_cents) { %>dont <%= euros(c.remise_cagnotte_cents) %> de cagnotte<% } else { %>payée<% } %>
            </small>
          <% } else if (c.paiement && c.paiement.statut === 'autorise') { %>
            <%# Une empreinte attend : soit on la débite (la commande a été
                retirée), soit on la rend (personne n'est venu). Rien ne se
                décide tout seul — c'est un arbitrage, pas une mécanique. %>
            <p class="aide" style="margin:0 0 .4rem">
              Empreinte de <%= euros(c.paiement.montant_cents) %> prise
            </p>
            <form method="post" action="/salon/paiements/<%= c.paiement.id %>/capturer">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (c.cagnotte_cents > 0) { %>
                <input type="text" name="cagnotte" inputmode="decimal" placeholder="cagnotte"
                       title="Cagnotte disponible : <%= euros(c.cagnotte_cents) %> — déduite du montant débité"
                       style="width:6.5rem;margin-bottom:.35rem" autocomplete="off">
              <% } %>
              <button type="submit" class="btn btn--sm">Débiter</button>
            </form>
            <form method="post" action="/salon/paiements/<%= c.paiement.id %>/liberer"
                  onsubmit="return confirm('Libérer l\'empreinte sans rien débiter ? La commande sera annulée.')"
                  style="margin-top:.35rem">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn--ghost btn--sm">Libérer</button>
            </form>
          <% } else if (c.statut === 'a_payer') { %>
            <small style="color:var(--muted)">carte en attente</small>
          <% } else if (c.statut !== 'annulee') { %>
            <form method="post" action="/salon/commandes/<%= c.id %>/encaisser">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (c.cagnotte_cents > 0) { %>
                <input type="text" name="cagnotte" inputmode="decimal" placeholder="cagnotte"
                       title="Cagnotte disponible : <%= euros(c.cagnotte_cents) %>"
                       style="width:6.5rem;margin-bottom:.35rem" autocomplete="off">
              <% } %>
              <button type="submit" class="btn btn--sm">Encaisser</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>
</div>
<% } %>
<%- salonPied %>
