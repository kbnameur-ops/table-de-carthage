<%- entete %>
<div class="wrap">
  <p class="fil"><a href="/#soirees">Nos soirées</a></p>
  <h1><%= evenement.titre %></h1>
  <p class="lead">
    <%= dateLongue(evenement.date) %> · <%= evenement.heure %>
  </p>

  <% if (!evenement.visible) { %>
    <div class="alerte alerte--info">
      <strong>Soirée non publiée.</strong> Vous la voyez parce que vous en avez
      l'adresse ; elle n'apparaît pas encore sur le site et n'accepte aucune
      réservation.
    </div>
  <% } %>

  <% if (evenement.photos.length) { %>
    <%# Ici les photos ne défilent pas : on les regarde. Le ruban animé est
        fait pour attirer l'œil en page d'accueil, pas pour être consulté. %>
    <div class="galerie-soiree">
      <% evenement.photos.forEach(p => { %>
        <figure>
          <img src="<%= p.url %>" alt="<%= p.legende %>" loading="lazy" decoding="async">
          <% if (p.legende) { %><figcaption><%= p.legende %></figcaption><% } %>
        </figure>
      <% }) %>
    </div>
  <% } %>

  <div class="soiree-detail">
    <div class="soiree-detail__recit">
      <% if (evenement.accroche) { %>
        <p class="soiree-detail__accroche"><%= evenement.accroche %></p>
      <% } %>
      <% paragraphes.forEach(p => { %>
        <p><%= p %></p>
      <% }) %>
    </div>

    <aside class="soiree-detail__reserver">
      <div class="card">
        <p class="montant-du">
          <span>Par personne</span>
          <b><%= euros(evenement.prix_cents) %></b>
        </p>
        <p class="aide" style="margin-top:.4rem">
          <% if (evenement.estPasse) { %>
            Cette soirée a déjà eu lieu.
          <% } else if (evenement.placesRestantes <= 0) { %>
            Complet — plus aucune place disponible.
          <% } else { %>
            <%= evenement.placesRestantes %> place<%= evenement.placesRestantes > 1 ? 's' : '' %>
            encore disponible<%= evenement.placesRestantes > 1 ? 's' : '' %> sur <%= evenement.places %>.
          <% } %>
        </p>
      </div>
    </aside>
  </div>

  <% if (!evenement.estPasse && evenement.placesRestantes > 0 && evenement.visible) { %>
    <form method="post" action="/evenements/<%= evenement.slug %>/reserver" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <% if (erreurGenerale) { %>
        <div class="alerte alerte--erreur"><%= erreurGenerale %></div>
      <% } %>

      <h2>Combien de places&nbsp;?</h2>
      <div class="card">
        <div class="field <%= erreurs.places ? 'champ-invalide' : '' %>" style="max-width:14rem">
          <label for="f-places">Nombre de places</label>
          <input type="number" id="f-places" name="places" min="1"
                 max="<%= Math.min(20, evenement.placesRestantes) %>"
                 value="<%= valeurs.places || 2 %>" required>
          <% if (erreurs.places) { %><span class="erreur"><%= erreurs.places %></span><% } %>
        </div>
      </div>

      <h2>Vos coordonnées</h2>

      <% if (client) { %>
        <div class="card carte-identifie">
          <div class="identifie">
            <span class="identifie__pastille" aria-hidden="true"><%= client.prenom.charAt(0) %><%= client.nom.charAt(0) %></span>
            <div class="identifie__qui">
              <strong><%= client.prenom %> <%= client.nom %></strong>
              <small><%= client.telephone_saisi %> · <%= client.email %></small>
            </div>
            <button type="submit" name="action" value="changer" class="btn btn--ghost btn--sm">Ce n'est pas moi</button>
          </div>
        </div>
      <% } else { %>
        <div class="card bloc-identite">
          <div class="identite-choix">
            <section class="identite-choix__col">
              <h3>Déjà venu chez nous&nbsp;?</h3>
              <p class="aide">Retrouvez vos informations avec votre téléphone et votre date de naissance.</p>
              <% if (erreurConnexion) { %>
                <div class="alerte alerte--erreur" style="margin-bottom:1rem"><%= erreurConnexion %></div>
              <% } %>
              <div class="field">
                <label for="c-tel">Téléphone</label>
                <input type="tel" id="c-tel" name="telephone" value="<%= valeurs.telephone || '' %>" autocomplete="tel">
              </div>
              <div class="field">
                <label for="c-naissance">Date de naissance</label>
                <input type="date" id="c-naissance" name="dateNaissance" value="<%= valeurs.dateNaissance || '' %>">
              </div>
              <button type="submit" name="action" value="connexion" class="btn btn--bloc">Me reconnaître</button>
            </section>

            <div class="identite-choix__ou" aria-hidden="true"><span>ou</span></div>

            <section class="identite-choix__col">
              <h3>Première fois&nbsp;?</h3>
              <p class="aide">Renseignez vos coordonnées : votre espace client sera créé automatiquement.</p>
              <div class="field--row">
                <div class="field <%= erreurs.prenom ? 'champ-invalide' : '' %>">
                  <label for="f-prenom">Prénom</label>
                  <input type="text" id="f-prenom" name="prenom" value="<%= valeurs.prenom || '' %>" autocomplete="given-name">
                  <% if (erreurs.prenom) { %><span class="erreur"><%= erreurs.prenom %></span><% } %>
                </div>
                <div class="field <%= erreurs.nom ? 'champ-invalide' : '' %>">
                  <label for="f-nom">Nom</label>
                  <input type="text" id="f-nom" name="nom" value="<%= valeurs.nom || '' %>" autocomplete="family-name">
                  <% if (erreurs.nom) { %><span class="erreur"><%= erreurs.nom %></span><% } %>
                </div>
              </div>
              <div class="field <%= erreurs.email ? 'champ-invalide' : '' %>">
                <label for="f-email">E-mail</label>
                <input type="email" id="f-email" name="email" value="<%= valeurs.email || '' %>" autocomplete="email">
                <% if (erreurs.email) { %><span class="erreur"><%= erreurs.email %></span><% } %>
              </div>
              <% if (erreurs.telephone) { %>
                <p class="field"><span class="erreur"><%= erreurs.telephone %></span></p>
              <% } %>
              <% if (erreurs.dateNaissance) { %>
                <p class="field"><span class="erreur"><%= erreurs.dateNaissance %></span></p>
              <% } %>
            </section>
          </div>
        </div>
      <% } %>

      <div class="btn-row">
        <button type="submit" class="btn">Réserver et payer</button>
      </div>
      <p class="aide">
        Le règlement se fait maintenant, en ligne. C'est ce qui garde votre place :
        le nombre de couverts est limité.
      </p>
    </form>
  <% } %>
</div>
<%- pied %>
